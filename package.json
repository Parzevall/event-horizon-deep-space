        }
      }
    ],
    "productIconThemes": [
      {
        "id": "event-horizon-hull",
        "label": "Event Horizon Hull",
        "path": "./product-icons/event-horizon-hull-product-icon-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/",
    "package": "npm run fonts && npm test && npx --yes @vscode/vsce@3 package --allow-missing-repository --skip-license",
    "fonts": "node scripts/build.js && uv run --no-project --with fonttools --with picosvg --with skia-pathops python scripts/build-fonts.py"
  }
}
