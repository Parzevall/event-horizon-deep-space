{
  "name": "event-horizon-deep-space",
  "displayName": "Event Horizon Deep Space Theme",
  "description": "A true-black theme with an accretion-orange accent and amber-phosphor syntax, plus Nerd Font file icons, chamfered Hull product icons, comment-tag pills, inline problems, git blame and folded-line counts.",
  "version": "1.0.0",
  "publisher": "parzivall",
  "author": {
    "name": "Parzevall"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Parzevall/event-horizon-deep-space"
  },
  "bugs": {
    "url": "https://github.com/Parzevall/event-horizon-deep-space/issues"
  },
  "homepage": "https://github.com/Parzevall/event-horizon-deep-space#readme",
  "keywords": [
    "theme",
    "dark theme",
    "black",
    "oled",
    "orange",
    "amber",
    "phosphor",
    "icon theme",
    "product icons",
    "nerd font",
    "space"
  ],
  "categories": [
    "Themes"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Git blame is turned off in Restricted Mode, because a repository's git config can run commands. The theme, icons and other features work everywhere."
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "themes": [
      {
        "label": "Event Horizon Deep Space",
        "uiTheme": "vs-dark",
        "path": "./themes/event-horizon-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "event-horizon-nerd",
        "label": "Event Horizon Nerd",
        "path": "./icons/event-horizon-nerd-icon-theme.json"
      },
      {
        "id": "event-horizon-tiles",
        "label": "Event Horizon Tiles",
        "path": "./icons/event-horizon-tiles-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "eventHorizon.applySetup",
        "title": "Apply Setup",
        "category": "Event Horizon"
      },
      {
        "command": "eventHorizon.revertSetup",
        "title": "Revert Setup",
        "category": "Event Horizon"
      },
      {
        "command": "eventHorizon.copyCustomCssPath",
        "title": "Copy Custom CSS Setting",
        "category": "Event Horizon"
      }
    ],
    "configuration": {
      "title": "Event Horizon",
      "properties": {
        "eventHorizon.commentTags.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show TODO, FIXME, NOTE and HACK (plus BUG, XXX) as colored pills inside comments."
        },
        "eventHorizon.inlineProblems.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the problem message at the end of the line it belongs to, with a soft tint on the line."
        },
        "eventHorizon.inlineProblems.minSeverity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info",
            "hint"
          ],
          "default": "warning",
          "description": "Least severe problem to show inline."
        },
        "eventHorizon.indentColumns.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Tint each indentation level with a faint column of color instead of hairline guides. Off by default; turn off editor.guides.indentation when using it."
        },
        "eventHorizon.foldedLines.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show how many lines a folded block hides, as a small pill after it."
        },
        "eventHorizon.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show who last changed the current line, when, and the commit message, in faint text at the end of the line."
        },
        "eventHorizon.trailingWhitespace.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Tint spaces and tabs at the end of lines, except on the line you're typing in."
        }
      }
    },
    "colors": [
      {
        "id": "eventHorizon.tagForeground",
        "description": "Text color of comment-tag pills.",
        "defaults": {
          "dark": "#000000",
          "light": "#FFFFFF",
          "highContrast": "#000000",
          "highContrastLight": "#FFFFFF"
        }
      },
      {
        "id": "eventHorizon.tagTodo",
        "description": "TODO pill background.",
        "defaults": {
          "dark": "#9BD67B",
          "light": "#0E7C66",
          "highContrast": "#9BD67B",
          "highContrastLight": "#0E7C66"
        }
      },
      {
        "id": "eventHorizon.tagFixme",
        "description": "FIXME and BUG pill background.",
        "defaults": {
          "dark": "#FF5F56",
          "light": "#C0362F",
          "highContrast": "#FF5F56",
          "highContrastLight": "#C0362F"
        }
      },
      {
        "id": "eventHorizon.tagNote",
        "description": "NOTE pill background.",
        "defaults": {
          "dark": "#9DB4FF",
          "light": "#3554B8",
          "highContrast": "#9DB4FF",
          "highContrastLight": "#3554B8"
        }
      },
      {
        "id": "eventHorizon.tagHack",
        "description": "HACK and XXX pill background.",
        "defaults": {
          "dark": "#FFC799",
          "light": "#A35A00",
          "highContrast": "#FFC799",
          "highContrastLight": "#A35A00"
        }
      },
      {
        "id": "eventHorizon.inlineErrorForeground",
        "description": "Inline error message text.",
        "defaults": {
          "dark": "#FF5F56",
          "light": "#C0362F",
          "highContrast": "#FF5F56",
          "highContrastLight": "#C0362F"
        }
      },
      {
        "id": "eventHorizon.inlineErrorBackground",
        "description": "Background tint of a line with an error.",
        "defaults": {
          "dark": "#FF5F561A",
          "light": "#C0362F14",
          "highContrast": "#FF5F561A",
          "highContrastLight": "#C0362F14"
        }
      },
      {
        "id": "eventHorizon.inlineWarningForeground",
        "description": "Inline warning message text.",
        "defaults": {
          "dark": "#FFC799",
          "light": "#A35A00",
          "highContrast": "#FFC799",
          "highContrastLight": "#A35A00"
        }
      },
      {
        "id": "eventHorizon.inlineWarningBackground",
