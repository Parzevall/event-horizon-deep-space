          "highContrastLight": "#FFB5472E"
        }
      },
      {
        "id": "eventHorizon.foldedForeground",
        "description": "Text of the hidden-lines pill after a folded block.",
        "defaults": {
          "dark": "#FF8A3D",
          "light": "#C2560F",
          "highContrast": "#FF8A3D",
          "highContrastLight": "#C2560F"
        }
      },
      {
        "id": "eventHorizon.foldedBackground",
        "description": "Background of the hidden-lines pill.",
        "defaults": {
          "dark": "#FF8A3D29",
          "light": "#C2560F1F",
          "highContrast": "#FF8A3D29",
          "highContrastLight": "#C2560F1F"
        }
      },
      {
        "id": "eventHorizon.blameForeground",
        "description": "Git blame text at the end of the current line.",
        "defaults": {
          "dark": "#5E5A55",
          "light": "#8A847D",
          "highContrast": "#5E5A55",
          "highContrastLight": "#8A847D"
        }
      },
      {
        "id": "eventHorizon.trailingWhitespaceBackground",
        "description": "Trailing spaces and tabs.",
        "defaults": {
          "dark": "#FF5F5647",
          "light": "#C0362F33",
          "highContrast": "#FF5F5647",
